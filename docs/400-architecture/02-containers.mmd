%% C4 level 2 — containers for zamphora.
%% Written by 400 Architecture, 2026-08-25. Redrawn 2026-09-17 for ADR-0014 to 0016 (Option E).
%% Every connection a box describes has an arrow.
%%
%% Two properties this diagram is drawn to show:
%%   1. The web box has no arrow to the table or the bucket. It holds no credentials.
%%   2. Only `assess` reaches Anthropic, through one adapter. The api holds no model key.

C4Container
    title Containers — zamphora, from 2026-09-17

    Person(keeper, "Plant keeper", "Account type USER. Phone, one hand, evening light.")
    Person(admin, "Admin", "The developer. Reaches the table through the AWS console only.")

    Container_Boundary(product, "zamphora") {
        Container(edge, "edge", "CloudFront, one host name", "Sends /api/assessments/:id/events to watch, every other /api/* to the api, everything else to the web files. ADR-0010, ADR-0015.")

        Container(web, "web", "Next.js static export, S3 + CloudFront", "The screens in both languages, built ahead of time. No server, no credentials. Fetches every value from the api. Holds one open stream while an assessment runs. ADR-0010.")

        Container(api, "api", "Nest.js on Lambda, apps/api", "Session, ownership, kill-switch, breaker, daily limit, photo checks and re-encode, the queued row. Starts the workflow and answers 202. Holds no model key. ADR-0002, ADR-0004, ADR-0014.")

        Container(workflow, "workflow", "Step Functions Standard", "ClaimRun, Assess, Persist, Rollup, Refund, RecordFailure. Retries Assess at most twice on three thrown errors. Writes rows directly. ADR-0014.")

        Container(assess, "assess", "Lambda, apps/api", "The one model call. Own role: the model key, the two CONFIG rows, the breaker row. Reserved concurrency 1. ADR-0014.")

        Container(watch, "watch", "Lambda with a Function URL, apps/api", "Streams the result to the phone over server-sent events. Reads the session and the row. ADR-0015.")

        Container(markfailed, "mark-failed", "Lambda", "Writes failed on the row when a run ends outside its own Catch. Invoked by an EventBridge rule on Execution Status Change.")

        Container(llm, "llm adapter", "packages/llm", "The only code allowed to import the Anthropic SDK. Behind the LlmProvider port. maxRetries 0. ADR-0005.")

        Container(contracts, "contracts", "packages/contracts", "Every type that crosses the wire. Imported by package name only.")

        ContainerDb(table, "table", "Amazon DynamoDB, one table", "Pots, assessments with a state field, care tasks, sessions, profiles, the daily counter, the day rollup, CONFIG and the breaker row. Owner id is the partition key. ADR-0002, ADR-0004.")

        ContainerDb(photos, "photos", "Amazon S3, private bucket", "One re-encoded photo per assessment, at most 1000 px. A lifecycle rule deletes it at 180 days. Never behind a cache. ADR-0007.")
    }

    System_Ext(cognito, "Amazon Cognito user pool", "Accounts, passwords, the sign-in pages, the USER and ADMIN groups.")
    System_Ext(anthropic, "Anthropic Messages API", "One vision call per attempt. Paid from the owner's own credit.")
    System_Ext(console, "AWS Management Console", "The admin's only way in.")

    Rel(keeper, edge, "Uses every screen", "HTTPS")
    Rel(admin, console, "Edits the kill-switch row. Reads the rollups", "HTTPS, by hand")
    Rel(console, table, "Reads and writes rows directly", "AWS API, IAM")

    Rel(edge, web, "Everything that is not /api/*", "HTTPS")
    Rel(edge, api, "/api/* except the stream path", "HTTPS, __Host-session cookie")
    Rel(edge, watch, "GET /api/assessments/:id/events only", "HTTPS, origin access control")
    Rel(web, edge, "Every read, write and the one stream, on the same origin", "fetch and EventSource")

    Rel(web, contracts, "Parses every answer with the same schema the api validated", "workspace import")
    Rel(api, contracts, "Validates every request", "workspace import")

    Rel(api, table, "GetItem, Query, the conditional increment, the queued row", "AWS SDK, IAM role")
    Rel(api, photos, "PutObject once. Signs a 5-minute read URL", "AWS SDK, IAM role")
    Rel(api, workflow, "StartExecution, name = the assessment id", "AWS SDK, IAM role")
    Rel(workflow, assess, "Task, with the retry rule", "Lambda invoke")
    Rel(workflow, table, "UpdateItem on the row and the rollup, no Lambda in between", "service integration")
    Rel(workflow, markfailed, "FAILED, TIMED_OUT, ABORTED", "EventBridge rule")
    Rel(markfailed, table, "UpdateItem state = failed", "IAM role")
    Rel(assess, table, "Reads CONFIG, writes the breaker row", "IAM role")
    Rel(assess, llm, "assess(photo, plantName, locale)", "LlmProvider port")
    Rel(llm, anthropic, "POST /v1/messages with output_config.format", "HTTPS")
    Rel(watch, table, "GetItem the session, then the row every 500 ms", "IAM role")

    Rel(keeper, cognito, "Signs in on Cognito's pages", "HTTPS redirect")
    Rel(api, cognito, "Swaps the code for an ID token and checks it", "OIDC code + PKCE")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
